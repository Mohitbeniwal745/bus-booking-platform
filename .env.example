# ==========================================
# Bus Booking Platform - Environment Configuration
# ==========================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pwd
POSTGRES_DB=bus_booking
DATABASE_URL=postgresql://postgres:postgres_secure_pwd@db:5432/bus_booking

# Application Settings
APP_ENV=production
PORT=8000
LOG_LEVEL=INFO

# Nginx / Reverse Proxy Ports
HTTP_PORT=80
HTTPS_PORT=443
